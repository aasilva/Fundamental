# URL pública da app (usada no link do email de confirmação de conta).
# Local: http://localhost:3000 — Vercel: https://<o-teu-projeto>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca expor no browser. Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Minutos que uma cotação fica em cache antes de ser atualizada (tier gratuito: 25 pedidos/dia)
QUOTE_CACHE_TTL_MINUTES=60

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Remetente verificado no Resend (ou o domínio de teste onboarding@resend.dev)
NOTIFICATIONS_FROM_EMAIL="Fundamental <onboarding@resend.dev>"

# Segredo aleatório para proteger o endpoint de cron (ex: `openssl rand -hex 32`)
CRON_SECRET=
