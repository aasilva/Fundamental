# URL pública da app (usada no link do email de confirmação de conta).
# Local: http://localhost:3000 — Vercel: https://<o-teu-projeto>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca expor no browser. Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cotações: tentadas por esta ordem; cada fornecedor só é usado se a chave existir ---
# 1. Alpha Vantage — https://www.alphavantage.co/support/#api-key (grátis: 25 pedidos/dia)
ALPHA_VANTAGE_API_KEY=
# 2. Finnhub — https://finnhub.io/register (grátis: 60/min, só ações dos EUA)
FINNHUB_API_KEY=
# 3. Pesquisa web com Claude (último recurso, pago por uso) — https://console.anthropic.com
ANTHROPIC_API_KEY=
QUOTE_AI_ENABLED=false
# QUOTE_AI_MODEL=claude-opus-5

# O intervalo de atualização automática é escolhido por cada utilizador em Definições (default 60 min).
# Mínimo para atualizar automaticamente cotações obtidas por AI (reduz custo; o botão ignora-o)
QUOTE_AI_CACHE_TTL_MINUTES=360
# Depois de nenhum fornecedor encontrar um ticker, esperar antes de voltar a tentar
QUOTE_NOT_FOUND_RETRY_HOURS=24
# Depois de uma falha temporária (limite de pedidos, erro de rede)
QUOTE_UNAVAILABLE_RETRY_MINUTES=60

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Remetente verificado no Resend (ou o domínio de teste onboarding@resend.dev)
NOTIFICATIONS_FROM_EMAIL="Fundamental <onboarding@resend.dev>"

# Segredo aleatório para proteger o endpoint de cron (ex: `openssl rand -hex 32`)
CRON_SECRET=
